partitionmanager.cpp + Android.mk: destroy the metadata-encryption dm device before Format Data

Format Data on a metadata-encrypted device unmounts /data but leaves the dm
mapping (mapper/userdata) alive, because Unmap_Super_Devices skips userdata on
purpose. make_f2fs then fails on the raw block device with
"Error: In use by the system!" (EBUSY), the format is refused, and /data stays
unmountable until reboot. Destroy the mapping right before the wipe.

The code links against libdm (dm::DeviceMapper), so Android.mk also adds
libdm to the recovery executable's LOCAL_STATIC_LIBRARIES: without it the
compile cannot even find the <dm/dm.h> header, because the recovery module
does not inherit libdm's exported include dir. Observed as
"partitionmanager.cpp:61:10: fatal error: 'dm/dm.h' file not found" at 92%.

--- a/partitionmanager.cpp
+++ b/partitionmanager.cpp
@@ -58,6 +58,7 @@
 #include <fs_mgr/roots.h>
 #include <libgsi/libgsi.h>
 #include <liblp/liblp.h>
+#include <dm/dm.h>
 #include <libgsi/libgsi.h>
 #include <liblp/builder.h>
 #include <libsnapshot/snapshot.h>
--- a/Android.mk
+++ b/Android.mk
@@ -142,6 +142,7 @@
 LOCAL_STATIC_LIBRARIES += libfoxui libvold
 # libvterm backs the in-UI terminal (gui/terminal.cpp).
 LOCAL_STATIC_LIBRARIES += libvterm
+LOCAL_STATIC_LIBRARIES += libdm
 LOCAL_SHARED_LIBRARIES += libz libc libcutils libstdc++ libtar libblkid libminuitwrp libmtdutils libtwadbbu
 LOCAL_SHARED_LIBRARIES += libbootloader_message libcrecovery libtwrpdigest libc++ libaosprecovery libcrypto libbase
 LOCAL_SHARED_LIBRARIES += libziparchive libselinux libdl_android.bootstrap
