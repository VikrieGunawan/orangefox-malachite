
/metadata                f2fs              /dev/block/by-name/metadata                          flags=display="Metadata [ metadata ]";backup=1
/data                        f2fs                /dev/block/by-name/userdata                          flags=display="Userdata [ data ]";fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption
/cache                     ext4                /dev/block/by-name/rescue                             flags=display="Cache [ rescue ]";wipeingui;wipeduringfactoryreset

/mi_ext                    ext4                /dev/block/mapper/mi_ext                               flags=display="MI EXT";logical
/mi_ext                    erofs                /dev/block/mapper/mi_ext                               flags=display="MI EXT";logical



/boot                                 emmc                      /dev/block/by-name/boot                              flags=display="Kernel Boot Image [ boot ] ";slotselect;backup=1;flashimg=1
/init_boot                     emmc                      /dev/block/by-name/init_boot                  flags=display="Init Boot Image [ init_boot ]";slotselect;backup=1;flashimg=1
/vendor_boot                     emmc                      /dev/block/by-name/vendor_boot                  flags=display="Vendor Boot Image [ vendor_boot ]";slotselect;backup=1;flashimg=1
/dtbo                                 emmc                      /dev/block/by-name/dtbo                              flags=display="Device Tree Blob Overlay [ dtbo ]";slotselect;backup=1
/vbmeta                            emmc                      /dev/block/by-name/vbmeta                          flags=display="Verified Boot Metadata [ vbmeta ]";slotselect;backup=1
/vbmeta_system                emmc                      /dev/block/by-name/vbmeta_system             flags=display="System Verified Boot [ vbmeta_system ]";slotselect;backup=1
/vbmeta_vendor                emmc                      /dev/block/by-name/vbmeta_vendor             flags=display="Vendor Verified Boot [ vbmeta_vendor ]";slotselect;backup=1

/persist                   emmc                       /dev/block/by-name/persist                         flags=display="Persistent [ persist ]";backup=1

/protect_f_image                 emmc                     /dev/block/by-name/protect1                         flags=display="Protect_F [ protect1 ]";backup=1
/protect_s_image                emmc                     /dev/block/by-name/protect2                        flags=display="Protect_S [ protect2 ]";backup=1
/nvdata_image                    emmc                     /dev/block/by-name/nvdata                           flags=display="Non-Volatile Data [ nvdata ]";backup=1
/nvcfg_image                      emmc                     /dev/block/by-name/nvcfg                             flags=display="Non-Volatile Config [ nvcfg ]";backup=1
/nvram                                emmc                     /dev/block/by-name/nvram                            flags=display="Non-Volatile RAM [ nvram ]";backup=1
/proinfo                              emmc                      /dev/block/by-name/proinfo                          flags=display="ProInfo [ proinfo ]";backup=1
/misc                                emmc                      /dev/block/by-name/misc                                flags=display="Miscellaneous [ misc ]";backup=1

/logo                                  emmc                      /dev/block/by-name/logo                              flags=display="Splashcreen Bootlogo [ logo ]";slotselect;backup=1

/usb_otg            auto      /dev/block/sdd1      /dev/block/sdd                                   flags=display="External Storage [ usb-otg ]";storage;wipeingui;removable;fsflags=utf8
