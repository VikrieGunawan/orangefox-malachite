#!/system/bin/sh
# Points /dev/cpu_temp at the thermal zone the recovery shows as CPU temperature.
# Zone numbers are not the same in recovery and in Android, so the zone is
# picked by its type name. A zone that reads 0 or less is skipped.
pick() {
    for want in "$@"; do
        for zone in /sys/class/thermal/thermal_zone*; do
            case "$(cat $zone/type 2>/dev/null)" in
            $want)
                temp=$(cat $zone/temp 2>/dev/null)
                if [ "${temp:-0}" -gt 0 ] 2>/dev/null; then
                    ln -sf $zone/temp /dev/cpu_temp
                    log -t cpu_temp_link "using $zone ($(cat $zone/type), $temp)"
                    return 0
                fi
                ;;
            esac
        done
    done
    return 1
}

# CPU sensors (soc_temp_lvts.ko). The driver may need a moment to register them.
i=0
while [ $i -lt 10 ]; do
    pick soc_max 'cpu-big-core*' 'cpu-little-core*' 'soc-top*' && exit 0
    i=$((i + 1))
    sleep 1
done
# No CPU sensor: fall back to the board thermistor next to the SoC (board_temp.ko).
pick ap_ntc && exit 0
log -t cpu_temp_link "no usable thermal zone, CPU temperature stays empty"
