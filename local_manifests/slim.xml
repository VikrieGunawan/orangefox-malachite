<?xml version="1.0" encoding="UTF-8"?>
<!-- Slim sync: drops emulator/google/linaro/amlogic device trees, GKI kernel
     prebuilts, Trusty sources and test projects that a malachite recovery
     build never uses. Takes only the device/kernel/bootable/trusty/test
     parts of OrangeFox's own remove-minimal.xml for fox_16.0 plus the same
     list used by the earlier slim sync. optional="true" keeps repo happy if
     a project disappears from the manifest. Rerun the workflow with
     slim_sync=false if the build ever complains about a missing module. -->
